# Django
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens com esquema, separadas por virgula. Em producao: https://<projeto>.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL 16 (AD-003), usado quando DATABASE_URL nao esta definida
POSTGRES_DB=kira
POSTGRES_USER=seu-usuario
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Producao (Neon, string pooled: host com -pooler). Definida, substitui as POSTGRES_*
# e liga sslmode=require. Deixe comentada no desenvolvimento local.
# DATABASE_URL=postgresql://neondb_owner:<senha>@ep-<endpoint>-pooler.sa-east-1.aws.neon.tech/neondb?sslmode=require&channel_binding=require
