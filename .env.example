# Django
DJANGO_SECRET_KEY=troque-esta-chave
DJANGO_DEBUG=True
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
# Origens com esquema, separadas por virgula. Em producao: https://<projeto>.vercel.app
DJANGO_CSRF_TRUSTED_ORIGINS=

# PostgreSQL 16 (AD-003), usado quando DATABASE_URL nao esta definida
POSTGRES_DB=kira
POSTGRES_USER=seu-usuario
POSTGRES_PASSWORD=
POSTGRES_HOST=localhost
POSTGRES_PORT=5433

# Producao (Supabase, transaction pooler na porta 6543). Definida, substitui as POSTGRES_*
# e liga sslmode=require. Deixe comentada no desenvolvimento local.
# DATABASE_URL=postgresql://postgres.<ref>:<senha>@aws-0-<regiao>.pooler.supabase.com:6543/postgres
